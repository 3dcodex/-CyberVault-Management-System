# Copy this file to .env and fill in real values before running the project.
# Never commit .env to version control.

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-django-secret-key-here

# Set to False in production
DEBUG=True

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=your-fernet-key-here

# Comma-separated list of allowed hosts
# In Railway: set to your-app.railway.app (no http/https prefix)
ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated list of trusted CSRF origins (include scheme)
# In Railway: must include your Railway domain, e.g. https://your-app.railway.app
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost

# PostgreSQL connection string (required in production — Railway provides this via the PostgreSQL plugin)
# Without this, the app falls back to SQLite which is wiped on every Railway deploy.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
